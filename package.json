{
  "name": "matchbook",
  "private": false,
  "version": "2.4.0",
  "description": "Matchbook: offline-first FRC scouting and sync platform",
  "author": "Rishan Reddy",
  "license": "MIT",
  "homepage": "https://github.com/rishanreddy/matchbook",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishanreddy/matchbook.git"
  },
  "bugs": {
    "url": "https://github.com/rishanreddy/matchbook/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "electron:dev": "pnpm dev",
    "build": "pnpm typecheck && electron-vite build",
    "electron:build": "pnpm build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm clean:release && pnpm build && electron-builder --dir",
    "build:win": "pnpm clean:release && pnpm build && electron-builder --win --publish never",
    "build:mac": "pnpm clean:release && pnpm build && electron-builder --mac --universal --publish never",
    "build:linux": "pnpm clean:release && pnpm build && electron-builder --linux --publish never",
    "test": "vitest run",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "test:e2e": "node scripts/e2e-electron.mjs",
    "test:assignments": "node scripts/e2e-assignments.mjs",
    "test:responsive": "node scripts/responsive-electron.mjs",
    "electron:dist": "pnpm build:unpack",
    "electron:dist:win": "pnpm build:win",
    "electron:dist:mac": "pnpm build:mac",
    "electron:dist:linux": "pnpm build:linux",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "verify:production": "pnpm test && pnpm typecheck && pnpm lint && pnpm docs:check && pnpm build",
    "preview": "electron-vite preview",
    "clean:release": "rm -rf release",
    "docs:sync": "node scripts/sync-readme.mjs && node scripts/sync-guide-docs.mjs",
    "docs:check": "node scripts/sync-readme.mjs --check && node scripts/sync-guide-docs.mjs --check"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/store": "0.11.2",
    "dompurify": "^3.4.16",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "react-tourlight": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "dexie": "^4.4.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.4.0",
    "js-yaml": "^4.3.2",
    "jsqr": "^1.4.0",
    "papaparse": "^5.5.3",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "qrcode.react": "^4.2.0",
    "querystring-es3": "^0.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2",
    "survey-core": "^2.5.17",
    "survey-creator-core": "^2.5.17",
    "survey-creator-react": "^2.5.17",
    "survey-react-ui": "^2.5.17",
    "tailwindcss": "^3.4.17",
    "tba-api-v3client": "^3.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.5",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=3": "^5.0.12",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@humanfs/node": "^0.16.8",
      "@babel/core": "^7.29.6",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.12",
      "protobufjs": "^7.5.6",
      "qs": "^6.16.0",
      "rxdb>ajv": "^8.18.0",
      "superagent": "^3.7.0",
      "postcss-selector-parser": "^7.1.3",
      "ws": "^8.21.0",
      "websocket-driver": "^0.7.5"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs",
      "rxdb"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
